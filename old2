<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Rural Health Hub &mdash; Rural Specialty Network &mdash; Hospital Overview</title>
<meta name="description" content="Turnkey specialty care for rural hospitals. Live in 60 days." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --navy:#369739; --navy-dk:#256827; --navy-soft:#E6F3E6;
    --red:#F7960F; --red-dk:#BC7009; --red-soft:#FEF2E2;
    --green:#369739; --green-dk:#256827; --green-soft:#E6F3E6;
    --ink:#171717; --bg:#FFFFFF; --soft:#F7F4EF;
    --muted:#6E6557; --hair:#E3DCCF;
    --radius:16px; --maxw:980px; --t:.32s cubic-bezier(.2,.7,.2,1);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:"Hanken Grotesk",-apple-system,sans-serif;
    font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;}
  ::selection{background:var(--navy);color:#fff;}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 clamp(22px,4.5vw,46px);}

  /* HERO */
  header.hero{position:relative;background:var(--bg);color:var(--ink);overflow:hidden;border-bottom:2px solid var(--ink);}
  header.hero::before{content:"";position:absolute;inset:0;pointer-events:none;
    background:
      radial-gradient(820px 360px at 92% -14%, rgba(247,150,15,.13), transparent 60%),
      radial-gradient(640px 320px at -4% 118%, rgba(54,151,57,.15), transparent 60%),
      radial-gradient(520px 300px at 50% 132%, rgba(247,150,15,.11), transparent 60%);}
  .hero-inner{position:relative;padding:30px 0 54px;}
  .cobrand{display:flex;align-items:center;gap:18px;flex-wrap:wrap;}
  .cobrand img.rhh{height:68px;width:auto;display:block;}
  .eyebrow{display:inline-block;margin-top:34px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;
    font-weight:700;color:#fff;background:var(--navy);border:1.5px solid var(--ink);padding:5px 12px;border-radius:999px;}
  h1.headline{font-family:"Bricolage Grotesque",serif;font-weight:700;color:var(--ink);
    font-size:clamp(2.1rem,5.2vw,3.5rem);line-height:1.03;margin:.4em 0 .25em;max-width:19ch;letter-spacing:-.015em;}
  h1.headline em{font-style:normal;color:var(--navy);}
  h1.headline u{text-decoration:none;color:var(--red);}
  .lede{font-size:clamp(1.05rem,2vw,1.22rem);max-width:60ch;color:#3a3a3a;margin:.5em 0 0;}
  .hero-meta{margin-top:26px;display:flex;flex-wrap:wrap;gap:9px;}
  .pill{font-family:"Hanken Grotesk";font-size:13px;font-weight:600;padding:8px 15px;border-radius:999px;cursor:pointer;
    background:var(--navy);border:1.5px solid var(--ink);color:#fff;transition:transform .15s,box-shadow .15s;}
  .hero-meta .pill:nth-child(even){background:var(--red);color:#fff;}
  .pill:hover{transform:translateY(-2px);box-shadow:3px 3px 0 var(--ink);}

  /* TABS */
  nav.tabs{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.93);backdrop-filter:blur(10px);
    border-bottom:2px solid var(--ink);}
  .tabs-inner{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;}
  .tabs-inner::-webkit-scrollbar{display:none;}
  .tab{flex:0 0 auto;appearance:none;background:none;border:none;cursor:pointer;
    font-family:"Hanken Grotesk";font-size:15px;font-weight:700;color:var(--muted);
    padding:17px 16px 14px;border-bottom:3px solid transparent;transition:color var(--t),border-color var(--t);white-space:nowrap;}
  .tab:hover{color:var(--navy);}
  .tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--red);}

  /* PANELS */
  main{padding:54px 0 30px;}
  .panel{display:none;}
  .panel.active{display:block;}
  .reveal{opacity:0;transform:translateY(16px);transition:opacity .55s ease,transform .55s cubic-bezier(.2,.7,.2,1);}
  .reveal.in{opacity:1;transform:none;}
  .sec-eyebrow{font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--navy);font-weight:700;}
  h2{font-family:"Bricolage Grotesque",serif;font-weight:700;font-size:clamp(1.7rem,3.6vw,2.5rem);
    line-height:1.08;margin:.28em 0 .35em;letter-spacing:-.015em;max-width:23ch;}
  p.intro{font-size:1.1rem;max-width:64ch;color:#2c2c2c;margin:0 0 6px;}

  /* CARDS */
  .grid{display:grid;gap:18px;margin-top:34px;}
  .grid.two{grid-template-columns:repeat(2,1fr);}
  .grid.three{grid-template-columns:repeat(3,1fr);}
  .card{background:#fff;border:2px solid var(--ink);border-radius:var(--radius);padding:25px 23px;
    position:relative;overflow:hidden;transition:transform var(--t),box-shadow var(--t);}
  .card::before{content:"";position:absolute;left:0;top:0;height:5px;width:100%;background:var(--navy);transform:scaleX(0);transform-origin:left;transition:transform var(--t);}
  .card.r::before{background:var(--red);}
  .card.g::before{background:var(--green);}
  .card.g .ico{background:var(--green-soft);color:var(--green-dk);}
  .card.g:hover{box-shadow:6px 8px 0 var(--green-dk);}
  .card:hover{transform:translateY(-4px);box-shadow:6px 8px 0 var(--ink);}
  .card:hover::before{transform:scaleX(1);}
  .card .ico{width:44px;height:44px;border-radius:11px;display:grid;place-items:center;margin-bottom:15px;
    background:var(--navy-soft);color:var(--navy);border:1.5px solid var(--ink);}
  .card.r .ico{background:var(--red-soft);color:var(--red-dk);}
  .card h3{font-family:"Bricolage Grotesque",serif;font-weight:700;font-size:1.18rem;margin:0 0 7px;line-height:1.18;}
  .card p{margin:0;font-size:.96rem;color:#3a3a3a;line-height:1.52;}
  .card.dark{background:var(--navy);color:#fff;}
  .card.dark::before{background:var(--red);}
  .card.dark h3{color:#fff;}
  .card.dark p{color:#DDEBDD;}
  .card.dark .ico{background:rgba(255,255,255,.14);color:#fff;}

  /* WHY HERO STAT */
  .whystat{margin-top:36px;border:2px solid var(--ink);border-radius:var(--radius);overflow:hidden;background:#fff;}
  .whystat .top{display:grid;grid-template-columns:.78fr 1.22fr;}
  .whystat .figure{background:var(--red-soft);padding:30px 28px;border-right:2px solid var(--ink);
    display:flex;flex-direction:column;justify-content:center;}
  .whystat .fnum{font-family:"Bricolage Grotesque";font-weight:800;font-size:clamp(3.6rem,10vw,5.4rem);
    line-height:.9;color:var(--red-dk);margin:0;letter-spacing:-.02em;}
  .whystat .fcap{font-size:.98rem;color:#3a3a3a;margin:14px 0 0;line-height:1.45;}
  .whystat .chartside{padding:26px 28px;}
  .whystat .chartside h3{font-family:"Bricolage Grotesque";font-weight:700;font-size:1.02rem;margin:0 0 3px;}
  .whystat .chartside .cs{font-size:.86rem;color:var(--muted);margin:0 0 16px;}
  .whystat .foot{border-top:2px solid var(--ink);background:var(--navy);color:#fff;padding:20px 28px;}
  .whystat .foot b{font-family:"Bricolage Grotesque";font-size:1.14rem;display:block;margin-bottom:4px;}
  .whystat .foot p{margin:0;font-size:.96rem;color:#DDEBDD;max-width:74ch;}
  .srcline{font-size:.76rem;color:var(--muted);margin:14px 0 0;line-height:1.55;padding:0 28px 20px;}
  .srcline b{color:var(--ink);}

  /* CAUSE CHAIN */
  .chain{margin-top:36px;display:grid;grid-template-columns:repeat(3,1fr);gap:0;
    border:2px solid var(--ink);border-radius:var(--radius);overflow:hidden;}
  .chain > div{padding:24px 22px;border-right:1.5px solid var(--hair);background:#fff;position:relative;}
  .chain > div:last-child{border-right:none;background:var(--red-soft);}
  .chain .cn{font-family:"Bricolage Grotesque";font-weight:800;font-size:.74rem;letter-spacing:.1em;
    text-transform:uppercase;color:var(--navy-dk);}
  .chain > div:last-child .cn{color:var(--red-dk);}
  .chain h4{font-family:"Bricolage Grotesque";font-weight:700;font-size:1.1rem;margin:7px 0 7px;}
  .chain p{margin:0;font-size:.92rem;color:#3a3a3a;line-height:1.5;}

  /* OUTCOME LIST */
  .outc{margin-top:34px;border:2px solid var(--ink);border-radius:var(--radius);overflow:hidden;}
  .outc-row{display:flex;gap:18px;align-items:flex-start;padding:20px 24px;border-bottom:1.5px solid var(--hair);background:#fff;
    transition:background var(--t);}
  .outc-row:last-child{border-bottom:none;}
  .outc-row:hover{background:var(--soft);}
  .outc-row .on{flex:0 0 auto;width:38px;height:38px;border-radius:10px;border:2px solid var(--ink);display:grid;place-items:center;
    font-family:"Bricolage Grotesque";font-weight:800;font-size:.9rem;background:var(--navy-soft);color:var(--navy-dk);}
  .outc-row:nth-child(even) .on{background:var(--red-soft);color:var(--red-dk);}
  .outc-row b{display:block;font-family:"Bricolage Grotesque";font-size:1.06rem;margin-bottom:3px;}
  .outc-row p{margin:0;font-size:.95rem;color:#3a3a3a;line-height:1.5;}

  .evidence{margin-top:34px;border:2px solid var(--ink);border-radius:var(--radius);padding:24px 24px 20px;background:#fff;}
  .evidence h3{font-family:"Bricolage Grotesque",serif;font-weight:700;font-size:1.16rem;margin:0 0 4px;line-height:1.2;}
  .evidence .sub{font-size:.94rem;color:var(--muted);margin:0 0 6px;max-width:62ch;line-height:1.52;}
  .src-note{font-size:.76rem;color:var(--muted);margin:22px 0 0;line-height:1.55;}
  .src-note b{color:var(--ink);}

  /* ---------- PATHWAY (matches Regional page) ---------- */
  .pathway{margin-top:36px;border:2px solid var(--ink);border-radius:var(--radius);overflow:hidden;background:#fff;}
  .pw-track{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding:26px 18px 22px;background:var(--soft);border-bottom:2px solid var(--ink);position:relative;}
  .pw-node{appearance:none;background:none;border:none;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;align-items:center;gap:9px;text-align:center;position:relative;padding:0 6px;}
  .pw-node .ring{width:60px;height:60px;border-radius:50%;display:grid;place-items:center;background:#fff;border:2.5px solid var(--hair);color:var(--muted);transition:all var(--t);position:relative;z-index:2;}
  .pw-node .nlabel{font-weight:700;font-size:.86rem;line-height:1.2;color:var(--muted);transition:color var(--t);max-width:15ch;}
  .pw-node .nstep{font-family:"Bricolage Grotesque";font-weight:700;font-size:.72rem;letter-spacing:.06em;color:#b6ad9d;text-transform:uppercase;transition:color var(--t);}
  .pw-node::after{content:"";position:absolute;top:30px;left:50%;width:100%;height:3px;background:var(--hair);z-index:1;}
  .pw-node:last-child::after{display:none;}
  .pw-node[aria-selected="true"] .ring{border-color:var(--active,var(--navy));color:var(--active,var(--navy));background:var(--active-soft,var(--navy-soft));transform:scale(1.06);box-shadow:0 6px 16px rgba(0,0,0,.10);}
  .pw-node[aria-selected="true"] .nlabel{color:var(--ink);}
  .pw-node[aria-selected="true"] .nstep{color:var(--active,var(--navy));}
  .pw-node:hover .ring{border-color:var(--active,var(--navy));}
  .pw-body{padding:28px;display:flex;gap:22px;align-items:flex-start;}
  .pw-body .pwicon{flex:0 0 auto;width:54px;height:54px;border-radius:13px;display:grid;place-items:center;border:2px solid var(--ink);background:var(--navy-soft);color:var(--navy);}
  .pw-body h4{font-family:"Bricolage Grotesque";font-weight:700;font-size:1.32rem;margin:2px 0 8px;}
  .pw-body p{margin:0;color:#3a3a3a;max-width:64ch;font-size:1rem;}
  .pwfade{animation:pwf .35s ease both;}
  @keyframes pwf{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:none;}}
  .pw-ctrls{display:flex;align-items:center;gap:10px;padding:0 28px 24px;}
  .pw-btn{appearance:none;font-family:"Hanken Grotesk";font-weight:700;font-size:.9rem;cursor:pointer;
    border:2px solid var(--ink);border-radius:999px;padding:9px 18px;background:#fff;color:var(--ink);transition:transform .15s,box-shadow .15s;}
  .pw-btn:hover{transform:translateY(-2px);box-shadow:3px 3px 0 var(--ink);}
  .pw-btn.play{background:var(--navy);color:#fff;}
  .pw-spec{margin-left:auto;font-size:.85rem;color:var(--muted);}
  .pw-spec b{color:var(--ink);}

  /* care-pathway infographic */
  .scene-wrap{border-bottom:2px solid var(--ink);background:#E6F3E6;line-height:0;position:relative;}
  .hiw-scene{width:100%;height:auto;display:block;}
  .scene-cap{position:absolute;left:18px;top:16px;z-index:2;background:#fff;border:1.5px solid var(--hair);
    border-radius:8px;padding:6px 12px;font-size:12px;font-weight:600;color:var(--navy);line-height:1.2;letter-spacing:.01em;}
  .scene-label{font-family:"Hanken Grotesk",sans-serif;font-weight:700;font-size:14px;fill:var(--ink);}
  .scene-cap2{font-family:"Hanken Grotesk",sans-serif;font-weight:500;font-size:11.5px;fill:var(--muted);}
  .grp-label{font-family:"Hanken Grotesk",sans-serif;font-weight:700;font-size:13px;fill:var(--navy);letter-spacing:.02em;}
  .medallion .halo{opacity:0;transition:opacity .45s ease;}
  .medallion .ring-active{opacity:0;transition:opacity .4s ease;}
  .medallion .liftable{transition:transform .45s cubic-bezier(.2,.7,.2,1);transform-box:fill-box;transform-origin:center;}
  .medallion.hl .halo{opacity:.14;}
  .medallion.hl .ring-active{opacity:1;}
  .medallion.hl .liftable{transform:scale(1.06);}
  .medallion.hl .scene-label{fill:var(--navy);}
  .tele-sig{opacity:0;transition:opacity .45s ease;}
  .medallion.hl .tele-sig{opacity:1;}
  #roadFwd{opacity:0;transition:opacity .4s ease;}
  #roadFwd.on{opacity:1;animation:flow 1.1s linear infinite;}
  #g-link{opacity:0;transition:opacity .4s ease;}
  #g-link.on{opacity:1;animation:flow 1s linear infinite;}
  #g-umclink{opacity:0;transition:opacity .4s ease;}
  #g-umclink.on{opacity:1;}
  #umc-oneway,#umc-both{opacity:0;transition:opacity .3s ease;}
  #umc-oneway.on,#umc-both.on{opacity:1;}
  #travelerPos{transition:transform .85s cubic-bezier(.45,.05,.3,1);}
  .pin-pulse{transform-box:fill-box;transform-origin:center;animation:pinp 2.6s ease-in-out infinite;}
  @keyframes flow{to{stroke-dashoffset:-32;}}
  @keyframes pinp{0%,100%{opacity:0;transform:scale(.55);}50%{opacity:.32;transform:scale(1.25);}}

  /* specialties dropdown */
  .spec-wrap{margin:22px 28px 14px;}
  .spec-wrap.plain{margin:26px 0 14px;}
  .spec-toggle{appearance:none;font-family:"Hanken Grotesk";font-weight:700;font-size:.9rem;cursor:pointer;background:var(--green-soft);
    border:1.5px solid var(--ink);border-radius:9px;color:var(--green-dk);padding:9px 15px;display:inline-flex;align-items:center;gap:9px;}
  .spec-toggle .caret{width:8px;height:8px;border-right:2.4px solid currentColor;border-bottom:2.4px solid currentColor;transform:rotate(45deg);transition:transform .25s;}
  .spec-toggle[aria-expanded="true"] .caret{transform:rotate(-135deg);}
  .spec-list{display:none;flex-wrap:wrap;gap:7px;margin-top:12px;}
  .spec-list.show{display:flex;}
  .spec-list span{font-size:.8rem;background:#fff;border:1px solid var(--hair);border-radius:999px;padding:5px 11px;color:#3a3a3a;}
  .spec-search{margin-top:18px;width:100%;max-width:340px;font-family:inherit;font-size:.95rem;padding:10px 14px;
    border:2px solid var(--ink);border-radius:10px;outline:none;}
  .spec-search:focus{border-color:var(--navy);}
  .spec-count{margin-top:12px;font-size:.85rem;color:var(--muted);}

  /* PROGRAM ACCORDION */
  .prog{margin-top:20px;border:2px solid var(--ink);border-radius:var(--radius);overflow:hidden;background:#fff;transition:box-shadow var(--t);}
  .prog:hover{box-shadow:5px 6px 0 var(--ink);}
  .prog-head{width:100%;appearance:none;background:#fff;border:none;cursor:pointer;font-family:inherit;text-align:left;
    display:flex;align-items:center;gap:16px;padding:22px 24px;}
  .prog-num{flex:0 0 auto;width:46px;height:46px;border-radius:12px;border:2px solid var(--ink);display:grid;place-items:center;
    font-family:"Bricolage Grotesque";font-weight:800;font-size:1rem;background:var(--navy-soft);color:var(--navy-dk);}
  .prog.r .prog-num{background:var(--red-soft);color:var(--red-dk);}
  .prog-t{flex:1;}
  .prog-t h3{font-family:"Bricolage Grotesque";font-weight:700;font-size:1.28rem;margin:0 0 3px;}
  .prog-t span{font-size:.92rem;color:var(--muted);}
  .prog-car{flex:0 0 auto;width:11px;height:11px;border-right:2.6px solid var(--muted);border-bottom:2.6px solid var(--muted);
    transform:rotate(45deg);transition:transform .28s;margin-right:4px;}
  .prog.open .prog-car{transform:rotate(-135deg);}
  .prog-body{display:none;padding:0 24px 26px;border-top:1.5px solid var(--hair);}
  .prog.open .prog-body{display:block;}
  .prog-body .who{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:20px;}
  .who div{background:var(--soft);border:1.5px solid var(--hair);border-radius:12px;padding:16px;}
  .who h5{font-family:"Bricolage Grotesque";font-weight:700;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;
    color:var(--navy-dk);margin:0 0 8px;}
  .who ul{margin:0;padding-left:17px;font-size:.9rem;color:#3a3a3a;}
  .who li{margin-bottom:4px;}
  .prog-lede{margin:18px 0 0;font-size:1rem;color:#2c2c2c;max-width:66ch;}
  .minibtn{display:inline-block;margin-top:18px;font-family:"Hanken Grotesk";font-weight:700;font-size:.85rem;
    text-decoration:none;padding:10px 18px;border-radius:999px;border:1.5px solid var(--ink);
    background:#500000;color:#fff;transition:transform .15s,box-shadow .15s,background .2s;}
  .minibtn:hover{transform:translateY(-2px);box-shadow:3px 3px 0 var(--ink);background:#6B0000;color:#fff;}

  /* ESTIMATOR */
  .estimator{margin-top:38px;border:2px solid var(--ink);border-radius:var(--radius);overflow:hidden;}
  .est-head{background:linear-gradient(120deg,var(--navy),var(--red));color:#fff;padding:22px 26px;}
  .est-head h3{font-family:"Bricolage Grotesque";font-weight:700;font-size:1.4rem;margin:0;color:#fff;}
  .est-head p{margin:6px 0 0;font-size:.9rem;color:#F2F6F2;max-width:62ch;}
  .est-body{display:grid;grid-template-columns:1.1fr .9fr;gap:0;}
  .est-inputs{padding:26px;border-right:2px solid var(--ink);}
  .est-out{padding:26px;background:var(--soft);}
  .est-sub{font-family:"Bricolage Grotesque";font-weight:700;font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--navy);margin:0 0 14px;}
  .est-sub.second{margin-top:26px;border-top:1.5px solid var(--hair);padding-top:22px;color:var(--green-dk);}
  .field{margin-bottom:19px;}
  .field:last-child{margin-bottom:0;}
  .field label{display:flex;justify-content:space-between;gap:10px;font-weight:700;font-size:.9rem;margin-bottom:8px;}
  .field label .val{color:var(--navy);font-variant-numeric:tabular-nums;white-space:nowrap;}
  input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:6px;border-radius:999px;background:var(--hair);outline:none;}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;
    background:var(--navy);border:2px solid var(--ink);cursor:pointer;}
  input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:var(--navy);border:2px solid var(--ink);cursor:pointer;}
  .out-label{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);}
  .out-big{font-family:"Bricolage Grotesque";font-weight:800;font-size:clamp(2.1rem,6vw,3rem);line-height:1;margin:6px 0 4px;
    color:var(--navy);font-variant-numeric:tabular-nums;}
  .out-sub{font-size:.9rem;color:#3a3a3a;margin:0 0 18px;}
  .out-group .gh{font-family:"Bricolage Grotesque";font-weight:700;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding:14px 0 4px;border-top:1.5px solid var(--hair);}
  .out-row{display:flex;justify-content:space-between;gap:12px;padding:8px 0;font-size:.95rem;}
  .out-row span{color:#3a3a3a;}
  .out-row b{font-variant-numeric:tabular-nums;color:var(--ink);}
  .out-total{display:flex;justify-content:space-between;gap:12px;align-items:baseline;margin-top:14px;padding-top:14px;border-top:2px solid var(--ink);}
  .out-total .ot-l{font-family:"Bricolage Grotesque";font-weight:700;font-size:.95rem;}
