  var strip = function(s){ return s.replace(/&amp;/g,'&').toLowerCase(); };
  var shown = 0;
  [['listA',CLINIC],['listB',CURB]].forEach(function(pair){
    var el = document.getElementById(pair[0]);
    var items = pair[1].filter(function(s){ return strip(s).indexOf(filter) !== -1; });
    shown += items.length;
    el.innerHTML = items.map(function(s){ return '<span>'+s+'</span>'; }).join('') ||
      '<span style="border-style:dashed;color:#6E6557">No match &mdash; ask us about it</span>';
  });
  document.getElementById('specCount').textContent = filter
    ? shown + ' matching entries across both lists'
    : '25+ scheduled clinic specialties \u00b7 30+ curbside specialties \u00b7 both growing';
}
renderSpecs('');
document.getElementById('specSearch').addEventListener('input', function(){ renderSpecs(this.value); });
document.querySelectorAll('.spec-toggle[data-list]').forEach(function(t){
  t.addEventListener('click', function(){
    var open = t.getAttribute('aria-expanded') === 'true';
    t.setAttribute('aria-expanded', open ? 'false' : 'true');
    document.getElementById(t.dataset.list).classList.toggle('show', !open);
  });
});

/* ---------- Sustainability Estimator ---------- */
var BASE_VISITS = 2648, WEEKS_PER_MONTH = 4, ORIGINATION_FEE = 31;

var REVENUE_CATS = [
  {id:"lab",  n:"Laboratory tests",            note:"Blended common labs (CBC ~$10, CMP ~$14)",           orders:9065, rate:13},
  {id:"xray", n:"X-ray",                        note:"Global rate, plain film e.g. chest 2-view",          orders:1159, rate:45},
  {id:"mri",  n:"MRI / MR imaging",             note:"Global rate (technical + professional)",             orders:311,  rate:500},
  {id:"ct",   n:"CT scan",                      note:"Global rate, head CT ~$207; body higher",            orders:53,   rate:250},
  {id:"us",   n:"Ultrasound",                   note:"Global rate, abdomen complete",                      orders:85,   rate:120},
  {id:"other",n:"Other diagnostic studies",     note:"Catch-all incl. pulmonary function tests; blended",  orders:308,  rate:195},
  {id:"sleep",n:"Sleep studies",                note:"Attended polysomnography",                           orders:41,   rate:600},
  {id:"proc", n:"Procedures (GI &amp; other)",  note:"Outpatient GI e.g. colonoscopy / EGD",                orders:46,   rate:350}
];
var RX_CATS = [
  {id:"rx_inf", n:"Rx: Infusions",              note:"Per administration; specialty / biologic 340B margin", orders:242,  rate:500},
  {id:"rx_inj", n:"Rx: Injectables",            note:"Per injection; blended specialty + standard",          orders:569,  rate:75},
  {id:"rx_oral",n:"Rx: Oral / topical / etc.",  note:"Per script; blended retail 340B margin",               orders:2199, rate:15}
];
var ENC_CATS = [
  {id:"orig", n:"Originating-site facility fee", note:"Per telehealth visit hosted at your facility", perVisit:1, rate:ORIGINATION_FEE}
];

/* 340B volume redistribution, matching the ROI calculator:
   half of infusion and injectable per-visit volume shifts into oral scripts. */
function rxPerVisit(){
  var raw = RX_CATS.map(function(c){ return c.orders / BASE_VISITS; });
  var infShift = raw[0] * 0.5, injShift = raw[1] * 0.5;
  return [raw[0] - infShift, raw[1] - injShift, raw[2] + infShift + injShift];
}

var rates = {}, enabled = {};
REVENUE_CATS.concat(RX_CATS, ENC_CATS).forEach(function(c){ rates[c.id] = c.rate; enabled[c.id] = true; });

function money(n){
  if(n >= 1e6) return '$' + (n/1e6).toFixed(n >= 1e7 ? 1 : 2) + 'M';
  if(n >= 1e3) return '$' + Math.round(n/1e3).toLocaleString() + 'K';
  return '$' + Math.round(n).toLocaleString();
}
function money2(n){ return '$' + n.toFixed(2); }

function buildRow(c, perVisit){
  var on = enabled[c.id];
  return '<div class="trow' + (on ? '' : ' off') + '" data-id="' + c.id + '">' +
    '<div class="cname"><span class="sw' + (on ? ' on' : '') + '" data-tog="' + c.id + '" role="switch" aria-checked="' + on + '" tabindex="0"><i></i></span>' +
      '<span><b>' + c.n + '</b><em>' + c.note + '</em></span></div>' +
    '<div class="num" data-l="Orders / visit">' + perVisit.toFixed(2) + '</div>' +
    '<div data-l="Your rate"><span class="rin"><span>$</span>' +
      '<input type="number" min="0" step="any" value="' + rates[c.id] + '" data-rate="' + c.id + '" aria-label="Rate for ' + c.n + '"></span></div>' +
    '<div class="num" data-l="Rev / visit" data-cell="pv"></div>' +
    '<div class="num" data-l="Orders / yr" data-cell="po"></div>' +
    '<div class="rev" data-l="Revenue / yr" data-cell="pr"></div>' +
  '</div>';
}

function renderTable(){
  var rx = rxPerVisit();
  document.getElementById('rowsDiag').innerHTML =
    REVENUE_CATS.map(function(c){ return buildRow(c, c.orders / BASE_VISITS); }).join('');
  document.getElementById('rowsEnc').innerHTML =
    ENC_CATS.map(function(c){ return buildRow(c, c.perVisit); }).join('');
  document.getElementById('rowsRx').innerHTML =
    RX_CATS.map(function(c, i){ return buildRow(c, rx[i]); }).join('');
  wireRows();
  calcRev();
}

function wireRows(){
  document.querySelectorAll('[data-rate]').forEach(function(el){
    el.addEventListener('input', function(){
      var v = this.value === '' ? 0 : Math.max(0, Number(this.value));
      rates[this.dataset.rate] = v;
      calcRev();
    });
    el.addEventListener('wheel', function(){ this.blur(); });
  });
  document.querySelectorAll('[data-tog]').forEach(function(el){
    var toggle = function(){
      var id = el.dataset.tog;
      enabled[id] = !enabled[id];
      el.classList.toggle('on', enabled[id]);
      el.setAttribute('aria-checked', enabled[id]);
      el.closest('.trow').classList.toggle('off', !enabled[id]);
      calcRev();
    };
    el.addEventListener('click', toggle);
    el.addEventListener('keydown', function(e){
      if(e.key === ' ' || e.key === 'Enter'){ e.preventDefault(); toggle(); }
    });
  });
}

function calcRev(){
  var vpw = +document.getElementById('i-vpw').value;
  var visits = vpw * WEEKS_PER_MONTH * 12;
  document.getElementById('v-vpw').textContent = vpw.toLocaleString();
  document.getElementById('v-vpy').textContent = '= ' + visits.toLocaleString() + ' visits / yr';

  var totalRev = 0, totalPer = 0;
  var rx = rxPerVisit();

  function fill(list, perVisitFn){
    list.forEach(function(c, i){
      var row = document.querySelector('.trow[data-id="' + c.id + '"]');
      if(!row) return;
      var pv = perVisitFn(c, i);
      var rate = rates[c.id] || 0;
      var revPer = pv * rate;
      var orders = pv * visits;
      var rev = revPer * visits;
      row.querySelector('[data-cell="pv"]').textContent = money2(revPer);
      row.querySelector('[data-cell="po"]').textContent = Math.round(orders).toLocaleString();
      row.querySelector('[data-cell="pr"]').textContent = money(rev);
      if(enabled[c.id]){ totalRev += rev; totalPer += revPer; }
    });
  }
  fill(REVENUE_CATS, function(c){ return c.orders / BASE_VISITS; });
  fill(ENC_CATS,     function(c){ return c.perVisit; });
  fill(RX_CATS,      function(c, i){ return rx[i]; });

  document.getElementById('o-total').textContent = money(totalRev);
  document.getElementById('o-pervisit').textContent = money2(totalPer);
  document.getElementById('o-visits').textContent = visits.toLocaleString();
}

document.getElementById('i-vpw').addEventListener('input', calcRev);
document.getElementById('btnReset').addEventListener('click', function(){
  REVENUE_CATS.concat(RX_CATS, ENC_CATS).forEach(function(c){ rates[c.id] = c.rate; enabled[c.id] = true; });
  renderTable();
});
renderTable();

runReveal(document.getElementById('why'));
</script>
